{
  "name": "aoe2-control-lua",
  "displayName": "AoE2 CONTROL Lua",
  "description": "Lua API definitions and snippets for CONTROL, the Lua scripting engine for Age of Empires II: Definitive Edition",
  "version": "1.1.0",
  "license": "MIT",
  "publisher": "BigJohn",
  "repository": "https://github.com/aoe2control/aoe2-control-lua-vscode-extension",
  "icon": "logo.png",
  "engines": {
    "vscode": "^1.105.0"
  },
  "extensionDependencies": [
    "sumneko.lua"
  ],
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "activationEvents": [
    "workspaceContains:**/*.main.lua",
    "workspaceContains:**/*.main.module"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "snippets": [
      {
        "language": "lua",
        "path": "./snippets/control-lua.code-snippets"
      }
    ],
    "configuration": {
      "title": "AoE2 CONTROL Lua",
      "properties": {
        "aoe2ControlLua.autoInjectLibrary": {
          "type": "boolean",
          "default": true,
          "description": "Add the CONTROL API definitions to the workspace's Lua.workspace.library setting so the Lua Language Server offers completion and hover help"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "package": "vsce package",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.2",
    "@types/vscode": "^1.105.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  },
  "keywords": [
    "aoe2",
    "age of empires",
    "lua",
    "control",
    "modding"
  ]
}
